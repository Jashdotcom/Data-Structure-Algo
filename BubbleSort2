import java.util.Scanner;

public class BubbleSort {

    public static void main(String[] args){

        //SORTS THE ARRAY USING BUBBLE SORT
        //SELECTS THE MAXIMUM ELEMENT FROM THE ARRAY &  PUSHES IT TO THE LAST USING ADJACENT SWAPING.
        //REPEAT THIS PROCESS TILL THE ARRAY IS SORTED.
       //BEST CASE,SINCE IT FIRST CHECKS WHETHER THE INPUT ARRAY IS ALREADY SORTED OR NOT.
       //IF ALREADY SORTED NO NEED TO TRAVERSE THROUGH 2 LOOPS AND MAKE IT WORSE.

        Scanner scanner = new Scanner(System.in);

        int[] arr;
        int[] sortedArr;
        int size;

        System.out.print("Enter the size of array : ");
        size=scanner.nextInt();

        arr=new int[size];
        sortedArr=new int[size];

        System.out.print("\nEnter the array elements : \n");

        for(int i=0;i<size;i++){
            System.out.printf("Enter element %d : ",i);
            arr[i]=scanner.nextInt();
        }

        System.out.print("\nUnsorted Array is : ");
        for(int i=0;i<size;i++){
            System.out.print(arr[i] + " ");
        }

        for(int i=size-1;i>=1;i--){
            int Swap=0;
            for(int j=0;j<=i-1;j++){
                if(arr[j]>arr[j+1]){
                    int max=j;
                    int temp=arr[j];
                    arr[j]=arr[j+1];
                    arr[j+1]=temp;
                    Swap=1;
                }

            }
            if(Swap==0){
                break;
            }
        }
        System.out.print("\nSorted Array is : ");
        for(int j=0;j<size;j++){
            System.out.print(arr[j] + " ");
        }
        scanner.close();
    }
}

